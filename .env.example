# App connection — least-privilege user, created by db:reset
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=emergency_resource_allocation
MYSQL_USER=era_app
MYSQL_PASSWORD=

# Admin account — used only by scripts (db:reset, bench)
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=eras

# Auth — 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional: Stadia map tiles key. Leave empty on localhost; needed on any other host.
NEXT_PUBLIC_STADIA_API_KEY=
